          "settings": {
            "question": "How long does shipping take?",
            "answer": "<p>Standard shipping within the continental US typically takes 3-5 business days. International shipping varies by location but generally takes 7-14 business days. Expedited shipping options are available at checkout. All orders include tracking information so you can monitor your package's journey.</p>",
            "category": "Shipping"
          }
        },
