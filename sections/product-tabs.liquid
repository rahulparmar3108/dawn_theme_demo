{{ 'section-product-tabs.css' | asset_url | stylesheet_tag }}

<div class="product-tabs page-width" id="ProductTabs-{{ section.id }}">
  
  {%- if section.blocks.size > 0 -%}
    <!-- Tab Navigation -->
    <div class="product-tabs__header">
      <div class="product-tabs__nav" role="tablist" aria-label="Product collections">
        {%- for block in section.blocks -%}
          {%- if block.type == 'tab' -%}
            <button
              class="product-tabs__tab{% if forloop.first %} active{% endif %}"
              role="tab"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-controls="tab-panel-{{ section.id }}-{{ forloop.index }}"
              id="tab-{{ section.id }}-{{ forloop.index }}"
              data-tab-index="{{ forloop.index }}"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.tab_name | default: 'Tab' }}
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a href="{{ section.settings.button_link }}" class="product-tabs__button link animate-arrow">
          {{ section.settings.button_label }}
          <span class="svg-wrapper">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
        </a>
      {%- endif -%}
    </div>

    <!-- Tab Panels -->
    {%- for block in section.blocks -%}
      {%- if block.type == 'tab' -%}
        {%- assign collection = collections[block.settings.collection] -%}
        <div
          class="product-tabs__panel{% if forloop.first %} active{% endif %}"
          role="tabpanel"
          id="tab-panel-{{ section.id }}-{{ forloop.index }}"
          aria-labelledby="tab-{{ section.id }}-{{ forloop.index }}"
          {{ block.shopify_attributes }}
        >
          {%- if collection != blank and collection.products_count > 0 -%}
            <ul class="product-tabs__grid list-unstyled" role="list">
              {%- assign products_to_show = section.settings.products_to_show | default: 8 -%}
              {%- for product in collection.products limit: products_to_show -%}
                <li class="product-tabs__item">
                  <div class="product-tabs__card">
                    <a href="{{ product.url }}" class="product-tabs__card-link">
                      <div class="product-tabs__image-wrapper">
                        {%- if product.featured_media -%}
                          <img
                            src="{{ product.featured_media | image_url: width: 533 }}"
                            alt="{{ product.featured_media.alt | escape }}"
                            width="533"
                            height="{{ 533 | divided_by: product.featured_media.aspect_ratio | round }}"
                            loading="lazy"
                            class="product-tabs__image"
                          >
                        {%- else -%}
                          {{ 'product-1' | placeholder_svg_tag: 'product-tabs__placeholder' }}
                        {%- endif -%}
                      </div>
                      <div class="product-tabs__card-info">
                        <h3 class="product-tabs__product-title">{{ product.title | escape }}</h3>
                        <p class="product-tabs__product-price">
                          {%- if product.compare_at_price > product.price -%}
                            <span class="product-tabs__price product-tabs__price--sale">
                              {{ product.price | money }}
                            </span>
                            <s class="product-tabs__price product-tabs__price--compare">
                              {{ product.compare_at_price | money }}
                            </s>
                          {%- else -%}
                            <span class="product-tabs__price">{{ product.price | money }}</span>
                          {%- endif -%}
                        </p>
                      </div>
                    </a>
                  </div>
                </li>
              {%- endfor -%}
            </ul>
           {%- else -%}
            <div class="product-tabs__empty">
              <p>{{ 'sections.collection_template.empty' | t }}</p>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}

  {%- else -%}
                  {%- for i in (1..products_to_show) -%}
                    <div class="f-column">
                      {% render 'card-product-placeholder'%}
                    </div>
                  {%- endfor -%}
                {%- endif -%}

</div>

<script>
  (function () {
    const section = document.getElementById('ProductTabs-{{ section.id }}');
    if (!section) return;

    const tabs = section.querySelectorAll('.product-tabs__tab');
    const panels = section.querySelectorAll('.product-tabs__panel');

    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        const index = this.dataset.tabIndex;

        // Deactivate all
        tabs.forEach(function (t) {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        panels.forEach(function (p) {
          p.classList.remove('active');
        });

        // Activate clicked
        this.classList.add('active');
        this.setAttribute('aria-selected', 'true');
        const targetPanel = section.querySelector('#tab-panel-{{ section.id }}-' + index);
        if (targetPanel) {
          targetPanel.classList.add('active');
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Product Tabs",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8,
      "label": "Maximum products to show"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View all"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "tab_name",
          "label": "Tab name",
          "default": "Tab name"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Tabs",
      "blocks": [
        {
          "type": "tab",
          "settings": {
            "tab_name": "Tab name"
          }
        },
        {
          "type": "tab",
          "settings": {
            "tab_name": "Tab name"
          }
        },
        {
          "type": "tab",
          "settings": {
            "tab_name": "Tab name"
          }
        }
      ]
    }
  ]
}
{% endschema %}
