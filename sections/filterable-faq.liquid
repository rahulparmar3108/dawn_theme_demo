<style>
  .shopdev .faq-category-pill {
    transition: all 0.3s ease;
  }
  
  .shopdev .faq-category-pill.active {
    background-color: var(--category-active-bg, #4F46E5);
    color: var(--category-active-text, white);
  }
  
  .shopdev .faq-item {
    transition: all 0.3s ease;
    overflow: hidden;
  }
  
  .shopdev .faq-answer {
    max-height: 0;
    opacity: 0;
    transition: all 0.3s ease;
  }
  
  .shopdev .faq-item.active .faq-answer {
    max-height: 1000px;
    opacity: 1;
  }
  
  .shopdev .faq-question-container {
    cursor: pointer;
  }
  
  .shopdev .faq-toggle-icon {
    transition: transform 0.3s ease;
  }
  
  .shopdev .faq-item.active .faq-toggle-icon {
    transform: rotate(45deg);
  }
  
  .shopdev mark {
    background-color: var(--highlight-color, #FEF08A);
    padding: 0 2px;
    border-radius: 2px;
  }
</style>
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="page-width-desktop  section-{{ section.id }}-padding">
  <div class="max-w-4xl mx-auto">
    <!-- Section Header -->
    <div class="text-center mb-10">
      {% if section.settings.heading != blank %}
        <h2 class="text-3xl font-bold mb-4">{{ section.settings.heading }}</h2>
      {% endif %}
      
      {% if section.settings.subheading != blank %}
        <p class="text-base text-gray-600 mb-6">{{ section.settings.subheading }}</p>
      {% endif %}
      
      <!-- Search Bar -->
      <div class="relative max-w-md mx-auto mb-8">
        <input 
          type="text"
          id="faq-search" 
          placeholder="{{ section.settings.search_placeholder }}"
          class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500"
        >
        <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
            <span class="svg-wrapper">
                {{- 'icon-search.svg' | inline_asset_content -}}
            </span>
        </div>
      </div>
      
      <!-- No Results Message (hidden by default) -->
      <div id="no-results-message" class="hidden text-gray-500 italic mb-6">
        {{ section.settings.no_results_text }}
      </div>
    </div>
    
    <!-- Category Pills -->
    <div class="flex flex-wrap justify-center gap-2 mb-8" id="faq-categories">
      <button 
        class="faq-category-pill active px-4 py-2 rounded-full text-sm font-medium" 
        data-category="all"
        style="--category-active-bg: {{ section.settings.category_active_bg }}; --category-active-text: {{ section.settings.category_active_text }}; background-color: {{ section.settings.category_active_bg }}; color: {{ section.settings.category_active_text }};"
      >
        {{ section.settings.all_categories_text }}
      </button>
      
      {% assign categories = '' %}
      {% for block in section.blocks %}
        {% if block.type == 'faq_item' %}
          {% assign category = block.settings.category | strip %}
          {% unless categories contains category %}
            {% assign categories = categories | append: category | append: ',' %}
            <button 
              class="faq-category-pill px-4 py-2 rounded-full text-sm font-medium bg-gray-100 text-gray-800 hover:bg-gray-200" 
              data-category="{{ category }}"
              style="--category-active-bg: {{ section.settings.category_active_bg }}; --category-active-text: {{ section.settings.category_active_text }};"
            >
              {{ category }}
            </button>
          {% endunless %}
        {% endif %}
      {% endfor %}
    </div>
    
    <!-- FAQ Items -->
    <div class="space-y-4" id="faq-container">
      {% for block in section.blocks %}
        {% if block.type == 'faq_item' %}
          <div 
            class="faq-item border border-gray-200 rounded-lg overflow-hidden" 
            data-category="{{ block.settings.category }}"
            {{ block.shopify_attributes }}
          >
            <div class="faq-question-container flex justify-between items-center p-5 bg-white">
              <h3 class="faq-question text-lg font-medium pr-8">{{ block.settings.question }}</h3>
              <span class="faq-toggle-icon text-2xl font-medium text-indigo-600">+</span>
            </div>
            <div class="faq-answer bg-gray-50 px-5 py-0">
              <div class="py-4">{{ block.settings.answer }}</div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

<script>
  class FAQSection {
    constructor(container) {
      this.container = container;
      this.faqItems = container.querySelectorAll('.faq-item');
      this.categoryButtons = container.querySelectorAll('.faq-category-pill');
      this.searchInput = container.querySelector('#faq-search');
      this.noResultsMessage = container.querySelector('#no-results-message');
      this.highlightColor = '{{ section.settings.highlight_color }}';
      
      this.init();
    }
    
    init() {
      // Set up question toggling
      this.setupQuestionToggle();
      
      // Set up category filtering
      this.setupCategoryFilters();
      
      // Set up search functionality
      this.setupSearch();
    }
    
    setupQuestionToggle() {
      this.faqItems.forEach(item => {
        const questionContainer = item.querySelector('.faq-question-container');
        
        questionContainer.addEventListener('click', () => {
          const isActive = item.classList.contains('active');
          
          // Close all other items
          if (!isActive && !this.searchInput.value) {
            this.faqItems.forEach(otherItem => {
              if (otherItem !== item) {
                otherItem.classList.remove('active');
              }
            });
          }
          
          // Toggle current item
          item.classList.toggle('active');
        });
      });
    }
    
    setupCategoryFilters() {
      this.categoryButtons.forEach(button => {
        button.addEventListener('click', () => {
          // Update active state for buttons
          this.categoryButtons.forEach(btn => btn.classList.remove('active'));
          button.classList.add('active');
          
          // Apply button styles
          button.style.backgroundColor = '{{ section.settings.category_active_bg }}';
          button.style.color = '{{ section.settings.category_active_text }}';
          
          // Reset other buttons
          this.categoryButtons.forEach(btn => {
            if (btn !== button) {
              btn.style.backgroundColor = '';
              btn.style.color = '';
            }
          });
          
          // Filter items
          const category = button.dataset.category;
          this.filterByCategory(category);
          
          // Clear search when changing categories
          this.searchInput.value = '';
          this.resetHighlighting();
        });
      });
    }
    
    setupSearch() {
      this.searchInput.addEventListener('input', () => {
        const searchTerm = this.searchInput.value.toLowerCase().trim();
        
        if (searchTerm === '') {
          // Reset to current category view when search is cleared
          const activeCategory = this.container.querySelector('.faq-category-pill.active').dataset.category;
          this.filterByCategory(activeCategory);
          this.resetHighlighting();
          this.noResultsMessage.classList.add('hidden');
          return;
        }
        
        let matchFound = false;
        
        this.faqItems.forEach(item => {
          const question = item.querySelector('.faq-question').textContent.toLowerCase();
          const answer = item.querySelector('.faq-answer').textContent.toLowerCase();
          const matches = question.includes(searchTerm) || answer.includes(searchTerm);
          
          if (matches) {
            matchFound = true;
            item.style.display = 'block';
            item.classList.add('active'); // Expand matching items
            
            // Highlight matching text
            this.highlightText(item, searchTerm);
          } else {
            item.style.display = 'none';
          }
        });
        
        // Show/hide no results message
        if (matchFound) {
          this.noResultsMessage.classList.add('hidden');
        } else {
          this.noResultsMessage.classList.remove('hidden');
        }
      });
    }
    
    filterByCategory(category) {
      this.faqItems.forEach(item => {
        if (category === 'all' || item.dataset.category === category) {
          item.style.display = 'block';
          item.classList.remove('active'); // Collapse all items when filtering
        } else {
          item.style.display = 'none';
        }
      });
      
      this.noResultsMessage.classList.add('hidden');
    }
    
    highlightText(item, searchTerm) {
      const question = item.querySelector('.faq-question');
      const answerDiv = item.querySelector('.faq-answer > div');
      
      // Store original text if not already stored
      if (!question.dataset.original) {
        question.dataset.original = question.innerHTML;
      }
      if (!answerDiv.dataset.original) {
        answerDiv.dataset.original = answerDiv.innerHTML;
      }
      
      // Get original text
      const originalQuestion = question.dataset.original;
      const originalAnswer = answerDiv.dataset.original;
      
      // Create regex for highlighting (case insensitive)
      const regex = new RegExp(`(${searchTerm})`, 'gi');
      
      // Apply highlighting
      question.innerHTML = originalQuestion.replace(regex, `<mark style="background-color: ${this.highlightColor}">$1</mark>`);
      answerDiv.innerHTML = originalAnswer.replace(regex, `<mark style="background-color: ${this.highlightColor}">$1</mark>`);
    }
    
    resetHighlighting() {
      this.faqItems.forEach(item => {
        const question = item.querySelector('.faq-question');
        const answerDiv = item.querySelector('.faq-answer > div');
        
        // Restore original text if available
        if (question.dataset.original) {
          question.innerHTML = question.dataset.original;
        }
        if (answerDiv.dataset.original) {
          answerDiv.innerHTML = answerDiv.dataset.original;
        }
      });
      
      this.noResultsMessage.classList.add('hidden');
    }
  }
  
  // Initialize the FAQ section when the DOM is fully loaded
  document.addEventListener('DOMContentLoaded', () => {
    const faqSections = document.querySelectorAll('.shopdev');
    faqSections.forEach(section => {
      new FAQSection(section);
    });
  });
</script>

{% schema %}
{
  "name": "Filterable FAQ Section",
  "class": "shopdev",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Find answers to common questions about our products and services"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder text",
      "default": "Search for questions..."
    },
    {
      "type": "text",
      "id": "all_categories_text",
      "label": "All categories button text",
      "default": "All Questions"
    },
    {
      "type": "text",
      "id": "no_results_text",
      "label": "No results message",
      "default": "No matching questions found. Please try a different search term."
    },
    {
      "type": "color",
      "id": "category_active_bg",
      "label": "Active category background color",
      "default": "#4F46E5"
    },
    {
      "type": "color",
      "id": "category_active_text",
      "label": "Active category text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Search highlight color",
      "default": "#FEF08A"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
