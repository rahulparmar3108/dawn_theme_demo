{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    padding-left: {{ section.settings.padding_sides | times: 0.75 | round: 0 }}px;
    padding-right: {{ section.settings.padding_sides | times: 0.75 | round: 0 }}px;
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
    margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      padding-left: {{ section.settings.padding_sides }}px;
      padding-right: {{ section.settings.padding_sides }}px;
      margin-top: {{ section.settings.margin_top }}px;
      margin-bottom: {{ section.settings.margin_bottom }}px;
    }
  }

  #why-we-are-better-{{ section.id }} {
    --heading-color: {{ section.settings.heading_color }};
    --title-color: {{ section.settings.title_color }};
    --text-color: {{ section.settings.text_color }};
    --icon-color: {{ section.settings.icon_color }};
    --bg-color: {{ section.settings.bg_color }};
    --border-color: {{ section.settings.border_color }};
    --image-border-color: {{ section.settings.image_border_color }};

    display: block;
    background: {{ section.settings.bg_gradient | default: section.settings.bg_color }};
    border-top: {{ section.settings.border_width }}px solid var(--border-color);
    border-bottom: {{ section.settings.border_width }}px solid var(--border-color);
  }

  .why-better__wrapper-{{ section.id }} {
    max-width: {{ section.settings.content_max_width }}px;
    margin: 0 auto;
  }

  /* Main Heading */
  .why-better__heading-{{ section.id }} {
    color: var(--heading-color);
    font-size: {{ section.settings.heading_size_mobile }}px;
    font-weight: {{ section.settings.heading_weight }};
    text-align: {{ section.settings.heading_alignment }};
    margin: 0 0 {{ section.settings.heading_margin_bottom }}px;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  @media screen and (min-width: 750px) {
    .why-better__heading-{{ section.id }} {
      font-size: {{ section.settings.heading_size_desktop }}px;
    }
  }

  /* Grid Layout */
  .why-better__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ section.settings.item_gap_mobile }}px;
    align-items: center;
  }

  @media screen and (min-width: 990px) {
    .why-better__grid {
      grid-template-columns: 1fr {{ section.settings.image_column_width }}px 1fr;
      gap: {{ section.settings.item_gap_desktop }}px;
    }
  }

  /* Columns */
  .why-better__column {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.item_gap_mobile }}px;
  }
  @media screen and (min-width: 990px) {
    .why-better__column {
      gap: {{ section.settings.item_gap_desktop }}px;
    }
  }

  /* Image Column Order on Mobile */
  .why-better__image-column {
    display: flex;
    justify-content: center;
    align-items: center;
    order: {{ section.settings.mobile_image_order }};
  }
  @media screen and (min-width: 990px) {
    .why-better__image-column {
      order: 2;
    }
    .why-better__column--left { order: 1; }
    .why-better__column--right { order: 3; }
  }

  /* Center Feature Image */
  .why-better__image-wrapper {
    position: relative;
    width: 100%;
    max-width: 100%;
    border-radius: {{ section.settings.image_border_radius }}px;
    border: {{ section.settings.image_border_width }}px solid var(--image-border-color);
    overflow: hidden;
    box-sizing: border-border;
  }

  .why-better__image-wrapper img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: {{ section.settings.image_border_radius }}px;
  }

  /* Feature Item Card */
  .why-better__item {
    display: flex;
    flex-direction: column;
    box-sizing: border-box;

    /* Content Alignment Mobile */
    {% case section.settings.content_alignment_mobile %}
      {% when 'left' %}
        align-items: flex-start;
        text-align: left;
      {% when 'right' %}
        align-items: flex-end;
        text-align: right;
      {% else %}
        align-items: center;
        text-align: center;
    {% endcase %}
  }

  @media screen and (min-width: 990px) {
    .why-better__item {
      /* Content Alignment Desktop */
      {% case section.settings.content_alignment_desktop %}
        {% when 'left' %}
          align-items: flex-start;
          text-align: left;
        {% when 'right' %}
          align-items: flex-end;
          text-align: right;
        {% else %}
          align-items: center;
          text-align: center;
      {% endcase %}
    }
  }

  /* Icons */
  .why-better__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: {{ section.settings.icon_size_mobile }}px;
    height: {{ section.settings.icon_size_mobile }}px;
    color: var(--icon-color);
    margin-bottom: 12px;
    flex-shrink: 0;
  }
  @media screen and (min-width: 750px) {
    .why-better__icon {
      width: {{ section.settings.icon_size_desktop }}px;
      height: {{ section.settings.icon_size_desktop }}px;
    }
  }
  .why-better__icon svg {
    width: 100%;
    height: 100%;
    stroke-width: 1.5;
  }
  .why-better__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Item Title */
  .why-better__item-title {
    color: var(--title-color);
    font-size: {{ section.settings.title_size_mobile }}px;
    font-weight: {{ section.settings.title_weight }};
    letter-spacing: {{ section.settings.title_letter_spacing }}px;
    margin: 0 0 {{ section.settings.title_margin_bottom }}px;
    line-height: 1.3;
    {% if section.settings.uppercase_titles %}
      text-transform: uppercase;
    {% endif %}
  }
  @media screen and (min-width: 750px) {
    .why-better__item-title {
      font-size: {{ section.settings.title_size_desktop }}px;
    }
  }

  /* Item Text */
  .why-better__item-text {
    color: var(--text-color);
    font-size: {{ section.settings.text_size_mobile }}px;
    line-height: {{ section.settings.text_line_height }};
    margin: 0;
    opacity: 0.88;
  }
  @media screen and (min-width: 750px) {
    .why-better__item-text {
      font-size: {{ section.settings.text_size_desktop }}px;
    }
  }
  {% if section.settings.hide_text_mobile %}
    @media screen and (max-width: 749px) {
      .why-better__item-text {
        display: none;
      }
    }
  {% endif %}
{%- endstyle -%}

<div
  id="why-we-are-better-{{ section.id }}"
  class="color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding"
>
  <div class="{% unless section.settings.full_width %}page-width{% endunless %} why-better__wrapper-{{ section.id }}">
    {%- if section.settings.heading != blank -%}
      <h2 class="why-better__heading-{{ section.id }}">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    <div class="why-better__grid">
      <!-- Left Column Features -->
      <div class="why-better__column why-better__column--left">
        {% for block in section.blocks %}
          {% if block.settings.column == 'left' %}
            <div class="why-better__item" {{ block.shopify_attributes }}>
              <div class="why-better__icon">
                {% if block.settings.custom_icon != blank %}
                  {{
                    block.settings.custom_icon
                    | image_url: width: 120
                    | image_tag: loading: 'lazy', alt: block.settings.title
                  }}
                {% else %}
                  {% render 'why-better-icons', icon: block.settings.icon %}
                {% endif %}
              </div>
              {% if block.settings.title != blank %}
                <h3 class="why-better__item-title">{{ block.settings.title }}</h3>
              {% endif %}
              {% if block.settings.text != blank %}
                <div class="why-better__item-text">{{ block.settings.text }}</div>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <!-- Center Showcase Image Column -->
      <div class="why-better__image-column">
        <div class="why-better__image-wrapper">
          {% if section.settings.image != blank %}
            {{
              section.settings.image
              | image_url: width: 1200
              | image_tag:
                loading: section.settings.lazy_load_setting,
                alt: section.settings.heading,
                widths: '375, 550, 750, 1100, 1500'
            }}
          {% else %}
            <img
              src="https://images.unsplash.com/photo-1592899677977-9c10ca588bbd?q=80&w=800&auto=format&fit=crop"
              alt="Showcase Product Placeholder"
              loading="lazy"
              width="800"
              height="800"
            >
          {% endif %}
        </div>
      </div>

      <!-- Right Column Features -->
      <div class="why-better__column why-better__column--right">
        {% for block in section.blocks %}
          {% if block.settings.column == 'right' %}
            <div class="why-better__item" {{ block.shopify_attributes }}>
              <div class="why-better__icon">
                {% if block.settings.custom_icon != blank %}
                  {{
                    block.settings.custom_icon
                    | image_url: width: 120
                    | image_tag: loading: 'lazy', alt: block.settings.title
                  }}
                {% else %}
                  {% render 'why-better-icons', icon: block.settings.icon %}
                {% endif %}
              </div>
              {% if block.settings.title != blank %}
                <h3 class="why-better__item-title">{{ block.settings.title }}</h3>
              {% endif %}
              {% if block.settings.text != blank %}
                <div class="why-better__item-text">{{ block.settings.text }}</div>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Why We Are Better",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "1. Heading Customization"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Why we are better",
      "label": "Section Heading Text"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 42,
      "label": "Heading Font Size (Desktop)"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 20,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 32,
      "label": "Heading Font Size (Mobile)"
    },
    {
      "type": "select",
      "id": "heading_weight",
      "options": [
        { "value": "400", "label": "Regular (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semi Bold (600)" },
        { "value": "700", "label": "Bold (700)" }
      ],
      "default": "500",
      "label": "Heading Font Weight"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center",
      "label": "Heading Alignment"
    },
    {
      "type": "range",
      "id": "heading_margin_bottom",
      "min": 10,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 48,
      "label": "Heading Margin Bottom"
