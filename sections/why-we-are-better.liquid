    {
      "type": "header",
      "content": "2. Body & Items Settings"
    },
    {
      "type": "range",
      "id": "item_gap_desktop",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 44,
      "label": "Gap Between Items (Desktop)"
    },
    {
      "type": "range",
      "id": "item_gap_mobile",
      "min": 12,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 32,
