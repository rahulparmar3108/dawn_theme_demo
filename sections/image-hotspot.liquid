{% comment %} Image Hotspot Section — Dawn theme {% endcomment %}
{{ 'image-hotspot.css' | asset_url | stylesheet_tag }}

{%- assign container_class = 'page-width' -%}
{%- if section.settings.container_width == 'large' -%}
  {%- assign container_class = 'page-width-large' -%}
{%- endif -%}
{%- if section.settings.container_width == 'full' -%}
  {%- assign container_class = '' -%}
{%- endif -%}

{%- assign img_style = 'object-fit:' | append: section.settings.obj_fit | append: ';width:100%;display:block;' -%}

{%- if section.settings.img_ratio != 'none' -%}
  {%- assign img_style = img_style | append: 'aspect-ratio:' | append: section.settings.img_ratio | append: ';' -%}
{%- endif -%}

{% comment %} {%- if section.settings.img_ratio == 'none' and section.settings.img_height != 'auto' -%}
  {%- assign img_style = img_style | append: 'height:' | append: section.settings.img_height | append: ';' -%}
{%- endif -%} {% endcomment %}

<div class="image-hotspot-section {{ container_class }}{% unless section.settings.show_mobile %} hs-section--hide-mobile{% endunless %}"
  style="padding-top:{{ section.settings.pad_top }}px;padding-bottom:{{ section.settings.pad_bot }}px;">


  {%- if section.settings.heading != blank -%}
    <h2 class="hs-heading" style="text-align:{{ section.settings.head_align }};">
      {{ section.settings.heading }}
    </h2>
  {%- endif -%}

    <div class="hs-image-wrap"
        data-ratio="{{ section.settings.img_ratio }}"
        style="border-radius:{{ section.settings.img_radius }}px;">
        {%- assign desktop_img = section.settings.desktop_image -%}
        {%- assign mobile_img = section.settings.mobile_image | default: desktop_img -%}
        {%- assign display_img = desktop_img | default: mobile_img -%}

        {%- if display_img != blank -%}
            <picture>

                {%- if mobile_img != blank -%}
                    <source
                        media="(max-width: 767px)"
                        srcset="
                        {{ mobile_img | image_url: width: 375 }} 375w,
                        {{ mobile_img | image_url: width: 550 }} 550w,
                        {{ mobile_img | image_url: width: 750 }} 750w">
                {%- endif -%}

                {{
                    display_img
                    | image_url: width: 1500
                    | image_tag:
                    loading: 'lazy',
                    class: 'hs-image',
                    widths: '550,750,1100,1500',
                    style: img_style
                }}

            </picture>
        {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'hs-image hs-placeholder' }}
        {%- endif -%}
        {%- comment -%} Hotspot 1 {%- endcomment -%}
        {%- if section.settings.hs_1_label != blank -%}
        <div class="hs-dot hs-dot--{{ section.settings.dot_type }}"
            style="left:{{ section.settings.hs_1_x }}%;top:{{ section.settings.hs_1_y }}%;width:{{ section.settings.dot_size }}px;height:{{ section.settings.dot_size }}px;color:{{ section.settings.dot_color }};"
            data-pos="{{ section.settings.popup_pos }}"
            role="button"
            tabindex="0"
            aria-label="{{ section.settings.hs_1_label }}">
            <span class="hs-ring"></span>
            <span class="hs-core"></span>
            <div class="hs-popup"
            style="border-radius:{{ section.settings.popup_radius }}px;padding:{{ section.settings.popup_pad }}px;"
            role="tooltip">
            <div class="hotspots-item-arrow"></div>
            {%- if section.settings.hs_1_type == 'video' and section.settings.hs_1_video != blank -%}
                {%- assign hs_video = section.settings.hs_1_video -%}
                <div class="hs-video-wrap">
                    <video
                        class="hs-video"
                        playsinline="true"
                        controls="controls"
                        preload="metadata"
                        {%- if hs_video.preview_image != blank -%}
                        poster="{{ hs_video.preview_image | image_url: width: 600 }}"
                        {%- endif -%}>
                        {%- for source in hs_video.sources -%}
                        <source src="{{ source.url }}" type="{{ source.mime_type }}">
                        {%- endfor -%}
                    </video>
                </div>
            {%- endif -%}
            <p class="hs-popup-title">{{ section.settings.hs_1_label }}</p>
            {%- if section.settings.hs_1_type == 'text' and section.settings.hs_1_desc != blank -%}
                <p class="hs-popup-desc">{{ section.settings.hs_1_desc }}</p>
            {%- endif -%}
            </div>
        </div>
        {%- endif -%}

        {%- comment -%} Hotspot 2 {%- endcomment -%}
        {%- if section.settings.hs_2_label != blank -%}
        <div class="hs-dot hs-dot--{{ section.settings.dot_type }}"
            style="left:{{ section.settings.hs_2_x }}%;top:{{ section.settings.hs_2_y }}%;width:{{ section.settings.dot_size }}px;height:{{ section.settings.dot_size }}px;color:{{ section.settings.dot_color }};"
            data-pos="{{ section.settings.popup_pos }}"
            role="button"
            tabindex="0"
            aria-label="{{ section.settings.hs_2_label }}">
            <span class="hs-ring"></span>
            <span class="hs-core"></span>
            <div class="hs-popup"
            style="border-radius:{{ section.settings.popup_radius }}px;padding:{{ section.settings.popup_pad }}px;"
            role="tooltip">
            <div class="hotspots-item-arrow"></div>
            {%- if section.settings.hs_2_type == 'video' and section.settings.hs_2_video != blank -%}
                {%- assign hs_video = section.settings.hs_2_video -%}
                <div class="hs-video-wrap">
                    <video
                        class="hs-video"
                        playsinline="true"
                        controls="controls"
                        preload="metadata"
                        {%- if hs_video.preview_image != blank -%}
                        poster="{{ hs_video.preview_image | image_url: width: 600 }}"
                        {%- endif -%}>
                        {%- for source in hs_video.sources -%}
                        <source src="{{ source.url }}" type="{{ source.mime_type }}">
                        {%- endfor -%}
                    </video>
                </div>
            {%- endif -%}
            <p class="hs-popup-title">{{ section.settings.hs_2_label }}</p>
            {%- if section.settings.hs_2_type == 'text' and section.settings.hs_2_desc != blank -%}
                <p class="hs-popup-desc">{{ section.settings.hs_2_desc }}</p>
            {%- endif -%}
            </div>
        </div>
        {%- endif -%}

        {%- comment -%} Hotspot 3 {%- endcomment -%}
        {%- if section.settings.hs_3_label != blank -%}
        <div class="hs-dot hs-dot--{{ section.settings.dot_type }}"
            style="left:{{ section.settings.hs_3_x }}%;top:{{ section.settings.hs_3_y }}%;width:{{ section.settings.dot_size }}px;height:{{ section.settings.dot_size }}px;color:{{ section.settings.dot_color }};"
            data-pos="{{ section.settings.popup_pos }}"
            role="button"
            tabindex="0"
            aria-label="{{ section.settings.hs_3_label }}">
            <span class="hs-ring"></span>
            <span class="hs-core"></span>
            <div class="hs-popup"
            style="border-radius:{{ section.settings.popup_radius }}px;padding:{{ section.settings.popup_pad }}px;"
            role="tooltip">
            <div class="hotspots-item-arrow"></div>
            {%- if section.settings.hs_3_type == 'video' and section.settings.hs_3_video != blank -%}
                {%- assign hs_video = section.settings.hs_3_video -%}
                {% comment %} <div class="hs-video-wrap">
                <iframe src="{{ section.settings.hs_3_video | replace: 'watch?v=', 'embed/' }}"
                    frameborder="0" allowfullscreen loading="lazy"></iframe>
                </div> {% endcomment %}
                <div class="hs-video-wrap">
                    <video
                        class="hs-video"
                        playsinline="true"
                        controls="controls"
                        preload="metadata"
                        {%- if hs_video.preview_image != blank -%}
                        poster="{{ hs_video.preview_image | image_url: width: 600 }}"
                        {%- endif -%}>
                        {%- for source in hs_video.sources -%}
                        <source src="{{ source.url }}" type="{{ source.mime_type }}">
                        {%- endfor -%}
                    </video>
                </div>
            {%- endif -%}
            <p class="hs-popup-title">{{ section.settings.hs_3_label }}</p>
            {%- if section.settings.hs_3_type == 'text' and section.settings.hs_3_desc != blank -%}
                <p class="hs-popup-desc">{{ section.settings.hs_3_desc }}</p>
            {%- endif -%}
            </div>
        </div>
        {%- endif -%}

        {%- comment -%} Hotspot 4 {%- endcomment -%}
        {%- if section.settings.hs_4_label != blank -%}
        <div class="hs-dot hs-dot--{{ section.settings.dot_type }}"
            style="left:{{ section.settings.hs_4_x }}%;top:{{ section.settings.hs_4_y }}%;width:{{ section.settings.dot_size }}px;height:{{ section.settings.dot_size }}px;color:{{ section.settings.dot_color }};"
            data-pos="{{ section.settings.popup_pos }}"
            role="button"
            tabindex="0"
            aria-label="{{ section.settings.hs_4_label }}">
            <span class="hs-ring"></span>
            <span class="hs-core"></span>
            <div class="hs-popup"
            style="border-radius:{{ section.settings.popup_radius }}px;padding:{{ section.settings.popup_pad }}px;"
            role="tooltip">
            <div class="hotspots-item-arrow"></div>
            {%- if section.settings.hs_4_type == 'video' and section.settings.hs_4_video != blank -%}
                {%- assign hs_video = section.settings.hs_4_video -%}
                <div class="hs-video-wrap">
                    <video
                        class="hs-video"
                        playsinline="true"
                        controls="controls"
                        preload="metadata"
                        {%- if hs_video.preview_image != blank -%}
                        poster="{{ hs_video.preview_image | image_url: width: 600 }}"
                        {%- endif -%}>
                        {%- for source in hs_video.sources -%}
                        <source src="{{ source.url }}" type="{{ source.mime_type }}">
                        {%- endfor -%}
                    </video>
                </div>
            {%- endif -%}
            <p class="hs-popup-title">{{ section.settings.hs_4_label }}</p>
            {%- if section.settings.hs_4_type == 'text' and section.settings.hs_4_desc != blank -%}
                <p class="hs-popup-desc">{{ section.settings.hs_4_desc }}</p>
            {%- endif -%}
            </div>
        </div>
        {%- endif -%}

        {%- comment -%} Hotspot 5 {%- endcomment -%}
        {%- if section.settings.hs_5_label != blank -%}
        <div class="hs-dot hs-dot--{{ section.settings.dot_type }}"
            style="left:{{ section.settings.hs_5_x }}%;top:{{ section.settings.hs_5_y }}%;width:{{ section.settings.dot_size }}px;height:{{ section.settings.dot_size }}px;color:{{ section.settings.dot_color }};"
            data-pos="{{ section.settings.popup_pos }}"
            role="button"
            tabindex="0"
            aria-label="{{ section.settings.hs_5_label }}">
            <span class="hs-ring"></span>
            <span class="hs-core"></span>
            <div class="hs-popup"
            style="border-radius:{{ section.settings.popup_radius }}px;padding:{{ section.settings.popup_pad }}px;"
            role="tooltip">
             <div class="hotspots-item-arrow"></div>
            {%- if section.settings.hs_5_type == 'video' and section.settings.hs_5_video != blank -%}
                {%- assign hs_video = section.settings.hs_5_video -%}
                <div class="hs-video-wrap">
                    <video
                        class="hs-video"
                        playsinline="true"
                        controls="controls"
                        preload="metadata"
                        {%- if hs_video.preview_image != blank -%}
                        poster="{{ hs_video.preview_image | image_url: width: 600 }}"
                        {%- endif -%}>
                        {%- for source in hs_video.sources -%}
                        <source src="{{ source.url }}" type="{{ source.mime_type }}">
                        {%- endfor -%}
                    </video>
                </div>
            {%- endif -%}
            <p class="hs-popup-title">{{ section.settings.hs_5_label }}</p>
            {%- if section.settings.hs_5_type == 'text' and section.settings.hs_5_desc != blank -%}
                <p class="hs-popup-desc">{{ section.settings.hs_5_desc }}</p>
            {%- endif -%}
            </div>
        </div>
        {%- endif -%}
    </div>
</div>

<script src="{{ 'image-hotspot.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Image hotspot",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "select",
      "id": "obj_fit",
      "label": "Object fit",
      "options": [
        { "value": "cover",   "label": "Cover"   },
        { "value": "contain", "label": "Contain" },
        { "value": "fill",    "label": "Fill"    }
      ],
      "default": "cover"
    },
    {
      "type": "select",
      "id": "img_ratio",
      "label": "Aspect ratio",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "16/9", "label": "16:9" },
        { "value": "4/3",  "label": "4:3"  },
        { "value": "1/1",  "label": "1:1"  }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "img_radius",
      "label": "Image border radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Hotspot style"
    },
    {
      "type": "select",
      "id": "dot_type",
      "label": "Hotspot type",
      "options": [
        { "value": "pulse", "label": "Pulse" },
        { "value": "plus",  "label": "Plus"  },
        { "value": "pin",   "label": "Pin"   }
      ],
      "default": "pulse"
    },
    {
      "type": "range",
      "id": "dot_size",
      "label": "Dot size",
      "min": 20,
      "max": 56,
      "step": 2,
      "default": 32,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Dot color",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "popup_pos",
      "label": "Popup position",
      "options": [
        { "value": "top",    "label": "Top"    },
        { "value": "bottom", "label": "Bottom" },
        { "value": "left",   "label": "Left"   },
        { "value": "right",  "label": "Right"  }
      ],
      "default": "top"
    },
    {
      "type": "range",
      "id": "popup_radius",
      "label": "Popup border radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "default": 8,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "popup_pad",
      "label": "Popup padding",
      "min": 8,
      "max": 32,
      "step": 2,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Shop the look"
    },
    {
      "type": "select",
      "id": "head_align",
      "label": "Heading alignment",
      "options": [
        { "value": "left",   "label": "Left"   },
        { "value": "center", "label": "Center" },
        { "value": "right",  "label": "Right"  }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container width",
      "options": [
        { "value": "page",  "label": "Page"       },
        { "value": "large", "label": "Large"      },
        { "value": "full",  "label": "Full width" }
      ],
      "default": "large"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 36,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "pad_bot",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 36,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "show_mobile",
      "label": "Show on mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "Hotspot 1"
    },
    {
      "type": "text",
      "id": "hs_1_label",
      "label": "Hotspot 1 label",
      "default": "Product 1"
    },
    {
      "type": "textarea",
      "id": "hs_1_desc",
      "label": "Hotspot 1 description",
      "default": "A great product for you."
    },
    {
      "type": "range",
      "id": "hs_1_x",
      "label": "Hotspot 1 X position",
      "min": 1,
      "max": 99,
      "step": 1,
      "default": 30,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "hs_1_y",
      "label": "Hotspot 1 Y position",
      "min": 1,
      "max": 99,
      "step": 1,
      "default": 40,
      "unit": "%"
    },
    {
      "type": "select",
      "id": "hs_1_type",
      "label": "Hotspot 1 content type",
      "options": [
        { "value": "text",  "label": "Text"  },
        { "value": "video", "label": "Video" }
