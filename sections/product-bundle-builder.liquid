<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web/src/regular/style.css">

<style>
  .shopdev .bundle-builder {
    --bundle-bg: {{ section.settings.background_color }};
    --bundle-text: {{ section.settings.text_color }};
    --bundle-border: #e4e8ee;
    --bundle-card: #f8fafc;
    --bundle-success: #04843f;
    --bundle-success-bg: #ecfdf3;
    --bundle-success-border: #9be7bd;
    background: var(--bundle-bg);
    color: var(--bundle-text);
    padding: 22px 0 34px;
  }

  .shopdev .bundle-builder__layout {
    display: grid;
    grid-template-columns: minmax(0, 2.1fr) minmax(330px, 0.95fr);
    gap: 32px;
    align-items: start;
  }

  .shopdev .bundle-builder__panel,
  .shopdev .bundle-summary {
    background: #fff;
    border: 1px solid #eef1f4;
    border-radius: 8px;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
  }

  .shopdev .bundle-builder__panel {
    min-width: 0;
    overflow: hidden;
    padding: 26px 24px 20px;
  }

  .shopdev .bundle-builder__title,
  .shopdev .bundle-summary__title {
    margin: 0;
    font-size: 20px;
    line-height: 1.25;
    font-weight: 700;
    letter-spacing: 0;
  }

  .shopdev .bundle-builder__intro {
    margin: 16px 0 26px;
    color: #1f3348;
    font-size: 14px;
    line-height: 1.45;
  }

  .shopdev .bundle-carousel {
    position: relative;
  }

  .shopdev .bundle-carousel__viewport {
    overflow-x: auto;
    overflow-y: hidden;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    margin: 0 -2px;
    padding: 0 2px 12px;
  }

  .shopdev .bundle-carousel__viewport::-webkit-scrollbar {
    display: none;
  }

  .shopdev .bundle-carousel__track {
    display: flex;
    gap: 16px;
  }

  .shopdev .bundle-product {
    flex: 0 0 calc((100% - 32px) / 3);
    min-width: 260px;
    scroll-snap-align: start;
  }

  .shopdev .bundle-product__card {
    height: 100%;
    background: var(--bundle-card);
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 18px;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .shopdev .bundle-product__card:hover {
    transform: translateY(-2px);
    border-color: var(--bundle-border);
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
  }

  .shopdev .bundle-product__media {
    aspect-ratio: 1.48;
    overflow: hidden;
    border-radius: 6px;
    background: #f1eee5;
    margin-bottom: 18px;
  }

  .shopdev .bundle-product__media img,
  .shopdev .bundle-product__placeholder {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .shopdev .bundle-product__title {
    margin: 0 0 8px;
    font-size: 16px;
    line-height: 1.3;
    font-weight: 700;
  }

  .shopdev .bundle-product__price {
    margin: 0 0 16px;
    color: #1f3348;
    font-size: 14px;
  }

  .shopdev .bundle-option {
    margin-bottom: 14px;
  }

  .shopdev .bundle-option__label {
    display: block;
    margin-bottom: 9px;
    color: #1f3348;
    font-size: 12px;
    line-height: 1.2;
  }

  .shopdev .bundle-swatch-list,
  .shopdev .bundle-choice-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .shopdev .bundle-swatch {
    width: 40px;
    height: 40px;
    border: 2px solid transparent;
    border-radius: 999px;
    background: var(--swatch-color, #cfd4dc);
    cursor: pointer;
    padding: 0;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .shopdev .bundle-swatch:hover,
  .shopdev .bundle-swatch.is-selected {
    transform: scale(1.05);
  }

  .shopdev .bundle-swatch.is-selected {
    border-color: #fff;
    box-shadow: 0 0 0 2px #111827;
  }

  .shopdev .bundle-choice {
    min-width: 40px;
    min-height: 26px;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    background: #fff;
    color: #000;
    cursor: pointer;
    font-size: 13px;
    line-height: 1;
    padding: 5px 11px;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .shopdev .bundle-choice:hover,
  .shopdev .bundle-choice.is-selected {
    border-color: #000;
    background: #000;
    color: #fff;
  }

  .shopdev .bundle-product__button,
  .shopdev .bundle-summary__button {
    width: 100%;
    min-height: 48px;
    border: 0;
    border-radius: 5px;
    background: #000;
    color: #fff;
    cursor: pointer;
    font-size: 14px;
    font-weight: 700;
    line-height: 1;
    transition: background 0.2s ease, opacity 0.2s ease;
  }

  .shopdev .bundle-product__button {
    min-height: 36px;
    margin-top: 2px;
  }

  .shopdev .bundle-product__button:hover,
  .shopdev .bundle-summary__button:hover {
    background: #1f2937;
  }

  .shopdev .bundle-product__button:disabled,
  .shopdev .bundle-summary__button:disabled {
    background: #cfd4dc;
    cursor: not-allowed;
  }

  .shopdev .bundle-carousel__button {
    position: absolute;
    top: 42%;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border: 1px solid #e5e7eb;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.96);
    color: #111827;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.12);
    transform: translateY(-50%);
    transition: opacity 0.2s ease, box-shadow 0.2s ease;
  }

  .shopdev .bundle-carousel__button:hover {
    box-shadow: 0 8px 18px rgba(15, 23, 42, 0.16);
  }

  .shopdev .bundle-carousel__button:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .shopdev .bundle-carousel__button--prev {
    left: -24px;
  }

  .shopdev .bundle-carousel__button--next {
    right: -24px;
  }

  .shopdev .bundle-carousel__dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    min-height: 12px;
    margin-top: 8px;
  }

  .shopdev .bundle-carousel__dot {
    width: 8px;
    height: 8px;
    border: 0;
    border-radius: 999px;
    background: #d1d5db;
    cursor: pointer;
    padding: 0;
    transition: width 0.2s ease, background 0.2s ease;
  }

  .shopdev .bundle-carousel__dot.is-active {
    width: 24px;
    background: #000;
  }

  .shopdev .bundle-summary {
    position: sticky;
    top: 20px;
    padding: 26px 24px;
  }

  .shopdev .bundle-summary__items {
    margin: 18px 0 28px;
    max-height: 280px;
    overflow-y: auto;
  }

  .shopdev .bundle-empty {
    padding: 24px 0;
    color: #9aa4b2;
    text-align: center;
  }

  .shopdev .bundle-empty i {
    display: block;
    margin-bottom: 6px;
    font-size: 40px;
  }

  .shopdev .bundle-empty p {
    margin: 0;
    font-size: 13px;
  }

  .shopdev .bundle-summary-item {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) 28px;
    gap: 12px;
    padding-bottom: 12px;
    margin-bottom: 12px;
    border-bottom: 1px solid #dde3ea;
  }

  .shopdev .bundle-summary-item__image {
    width: 64px;
    height: 64px;
    border-radius: 5px;
    background: #f1eee5;
    object-fit: cover;
  }

  .shopdev .bundle-summary-item__title {
    margin: 2px 0 2px;
    font-size: 14px;
    line-height: 1.25;
    font-weight: 700;
  }

  .shopdev .bundle-summary-item__variant {
    margin: 0 0 5px;
    color: #64748b;
    font-size: 13px;
    line-height: 1.25;
  }

  .shopdev .bundle-summary-item__price {
    margin: 0;
    font-size: 14px;
    font-weight: 700;
  }

  .shopdev .bundle-summary-item__remove {
    align-self: center;
    border: 0;
    background: transparent;
    color: #9aa4b2;
    cursor: pointer;
    padding: 4px;
    transition: color 0.2s ease;
  }

  .shopdev .bundle-summary-item__remove:hover {
    color: #dc2626;
  }

  .shopdev .bundle-discounts {
    border: 1px solid var(--bundle-success-border);
    border-radius: 7px;
    background: var(--bundle-success-bg);
    color: var(--bundle-success);
    padding: 17px 16px;
    margin-bottom: 24px;
  }

  .shopdev .bundle-discounts__title {
    margin: 0 0 10px;
    font-size: 14px;
    font-weight: 700;
  }

  .shopdev .bundle-discounts__list {
    margin: 0;
    padding-left: 16px;
    font-size: 12px;
    line-height: 1.8;
  }

  .shopdev .bundle-pricing {
    border-top: 1px solid #dde3ea;
    padding-top: 16px;
    margin-bottom: 24px;
  }

  .shopdev .bundle-pricing__row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 10px;
    color: #526070;
    font-size: 14px;
    line-height: 1.25;
  }

  .shopdev .bundle-pricing__row--discount {
    color: var(--bundle-success);
  }

  .shopdev .bundle-pricing__row--total {
    border-top: 1px solid #dde3ea;
    color: #000;
    font-size: 18px;
    font-weight: 800;
    margin-top: 12px;
    padding-top: 14px;
  }

  .shopdev .bundle-savings {
    display: none;
    border-radius: 5px;
    background: #d9fbe7;
    color: var(--bundle-success);
    margin-top: 16px;
    padding: 11px 14px;
    text-align: center;
    font-size: 14px;
    font-weight: 700;
  }

  .shopdev .bundle-requirement {
    margin: 12px 0 0;
    color: #64748b;
    font-size: 12px;
    line-height: 1.35;
    text-align: center;
  }

  .shopdev .bundle-builder__empty-products {
    color: #64748b;
    font-size: 14px;
    margin: 0;
    padding: 24px 0;
  }

  @media (max-width: 1180px) {
    .shopdev .bundle-product {
      flex-basis: calc((100% - 16px) / 2);
    }
  }

  @media (max-width: 990px) {
    .shopdev .bundle-builder__layout {
      grid-template-columns: 1fr;
    }

    .shopdev .bundle-summary {
      position: static;
    }

    .shopdev .bundle-carousel__button--prev {
      left: 8px;
    }

    .shopdev .bundle-carousel__button--next {
      right: 8px;
    }
  }

  @media (max-width: 640px) {
    .shopdev .bundle-builder {
      padding-top: 12px;
    }

    .shopdev .bundle-builder__panel,
    .shopdev .bundle-summary {
      padding: 20px 16px;
    }

    .shopdev .bundle-product {
      flex-basis: 84%;
      min-width: 250px;
    }

    .shopdev .bundle-carousel__button {
      display: none;
    }
  }
</style>

<div
  class="bundle-builder"
  data-bundle-builder="{{ section.id }}"
  data-money-format="{{ shop.money_format | escape }}"
>
  <div class="page-width">
    <div class="bundle-builder__layout">
      <div class="bundle-builder__panel">
        <h2 class="bundle-builder__title">
          {% if section.settings.heading != blank %}
            {{ section.settings.heading }}
          {% else %}
            Select Your Products
          {% endif %}
        </h2>

        <p class="bundle-builder__intro">
          Choose {{ section.settings.min_items }}{% if section.settings.max_items > section.settings.min_items %}-{{ section.settings.max_items }}{% endif %} items to build your bundle
        </p>

        <div class="bundle-carousel">
          <button class="bundle-carousel__button bundle-carousel__button--prev" type="button" data-carousel-prev aria-label="Previous products">
            <i class="ph ph-caret-left" aria-hidden="true"></i>
          </button>

          <div class="bundle-carousel__viewport" data-carousel-viewport>
            <div class="bundle-carousel__track" data-product-grid>
              {% assign has_products = false %}

              {% for block in section.blocks %}
                {% if block.type == 'product' %}
                  {% assign product = block.settings.product %}

                  {% if product != blank %}
                    {% assign has_products = true %}
                    {% assign selected_variant = product.selected_or_first_available_variant %}

                    <div class="bundle-product" {{ block.shopify_attributes }}>
                      <div
                        class="bundle-product__card"
                        data-product-card
                        data-product-id="{{ product.id }}"
                        data-variant-id="{{ selected_variant.id }}"
                      >
                        <div class="bundle-product__media">
                          {% if product.featured_image %}
                            {% assign product_image_alt = product.featured_image.alt | default: product.title | escape %}
                            {{ product.featured_image | image_url: width: 520 | image_tag:
                              loading: 'lazy',
                              widths: '260, 360, 520, 720',
                              sizes: '(max-width: 640px) 84vw, (max-width: 1180px) 40vw, 25vw',
                              alt: product_image_alt
                            }}
                          {% else %}
                            {{ 'product-1' | placeholder_svg_tag: 'bundle-product__placeholder' }}
                          {% endif %}
                        </div>

                        <h3 class="bundle-product__title">{{ product.title }}</h3>
                        <p class="bundle-product__price" data-product-price>{{ selected_variant.price | money }}</p>

                        {% unless product.has_only_default_variant %}
                          {% for option in product.options_with_values %}
                            {% assign option_index = forloop.index0 %}
                            {% assign option_name = option.name | downcase %}

                            {% if option_index == 0 %}
                              {% assign selected_option_value = selected_variant.option1 %}
                            {% elsif option_index == 1 %}
                              {% assign selected_option_value = selected_variant.option2 %}
                            {% else %}
                              {% assign selected_option_value = selected_variant.option3 %}
                            {% endif %}

                            <div class="bundle-option" data-option-group>
                              <span class="bundle-option__label">{{ option.name }}</span>

                              {% if option_name contains 'color' or option_name contains 'colour' %}
                                <div class="bundle-swatch-list">
                                  {% for value in option.values %}
                                    {% assign swatch_handle = value | handleize %}
                                    {% assign swatch_color = value | downcase | replace: ' ', '' %}

                                    {% case swatch_handle %}
                                      {% when 'black' %}
                                        {% assign swatch_color = '#111827' %}
                                      {% when 'white' %}
                                        {% assign swatch_color = '#ffffff' %}
                                      {% when 'gray', 'grey' %}
                                        {% assign swatch_color = '#cfd4dc' %}
                                      {% when 'navy' %}
                                        {% assign swatch_color = '#17213f' %}
                                      {% when 'blue' %}
                                        {% assign swatch_color = '#2563eb' %}
                                      {% when 'red' %}
                                        {% assign swatch_color = '#ef4444' %}
                                      {% when 'green' %}
                                        {% assign swatch_color = '#10b981' %}
                                      {% when 'yellow' %}
                                        {% assign swatch_color = '#facc15' %}
                                      {% when 'pink' %}
                                        {% assign swatch_color = '#f472b6' %}
                                      {% when 'bronze' %}
                                        {% assign swatch_color = '#cd7f32' %}
                                      {% when 'brown' %}
                                        {% assign swatch_color = '#92400e' %}
                                    {% endcase %}

                                    <button
                                      class="bundle-swatch{% if value == selected_option_value %} is-selected{% endif %}"
                                      type="button"
                                      data-option-button
                                      data-option-index="{{ option_index }}"
                                      data-option-value="{{ value | escape }}"
                                      style="--swatch-color: {{ swatch_color }};"
                                      aria-label="{{ value | escape }}"
                                      title="{{ value | escape }}"
                                    ></button>
                                  {% endfor %}
                                </div>
                              {% else %}
                                <div class="bundle-choice-list">
                                  {% for value in option.values %}
                                    <button
                                      class="bundle-choice{% if value == selected_option_value %} is-selected{% endif %}"
                                      type="button"
                                      data-option-button
                                      data-option-index="{{ option_index }}"
                                      data-option-value="{{ value | escape }}"
                                    >
                                      {{ value }}
                                    </button>
                                  {% endfor %}
                                </div>
                              {% endif %}
                            </div>
                          {% endfor %}
                        {% endunless %}

                        <button
                          class="bundle-product__button"
                          type="button"
                          data-add-to-bundle
                          data-product-id="{{ product.id }}"
                          data-product-title="{{ product.title | escape }}"
                          data-product-price="{{ selected_variant.price }}"
                          {% if product.featured_image %}
                            data-product-image="{{ product.featured_image | image_url: width: 160 }}"
                          {% endif %}
                        >
                          Add to Bundle
                        </button>

                        <script type="application/json" data-product-variants>
                          [
                            {% for variant in product.variants %}
                              {% assign variant_image = '' %}
                              {% if variant.featured_image %}
                                {% assign variant_image = variant.featured_image | image_url: width: 160 %}
                              {% elsif product.featured_image %}
                                {% assign variant_image = product.featured_image | image_url: width: 160 %}
                              {% endif %}

                              {
                                "id": {{ variant.id | json }},
                                "available": {{ variant.available | json }},
                                "title": {{ variant.title | json }},
                                "price": {{ variant.price | json }},
                                "option1": {{ variant.option1 | json }},
                                "option2": {{ variant.option2 | json }},
                                "option3": {{ variant.option3 | json }},
                                "image": {{ variant_image | json }}
                              }{% unless forloop.last %},{% endunless %}
                            {% endfor %}
                          ]
                        </script>
                      </div>
                    </div>
                  {% endif %}
                {% endif %}
              {% endfor %}
            </div>
          </div>

          <button class="bundle-carousel__button bundle-carousel__button--next" type="button" data-carousel-next aria-label="Next products">
            <i class="ph ph-caret-right" aria-hidden="true"></i>
          </button>

          <div class="bundle-carousel__dots" data-carousel-dots></div>
        </div>

        {% unless has_products %}
          <p class="bundle-builder__empty-products">Add product blocks to show bundle products here.</p>
        {% endunless %}
      </div>

      <aside class="bundle-summary">
        <h2 class="bundle-summary__title">Your Bundle</h2>

        <div class="bundle-summary__items" data-bundle-items>
          <div class="bundle-empty" data-empty-bundle>
            <i class="ph ph-shopping-bag" aria-hidden="true"></i>
            <p>No items added yet</p>
          </div>
        </div>

        {% if section.settings.enable_discounts %}
          <div class="bundle-discounts">
            <h3 class="bundle-discounts__title">Volume Discounts</h3>
            <ul class="bundle-discounts__list">
              <li>{{ section.settings.tier_1_quantity }}+ items: {{ section.settings.tier_1_discount }}% off</li>
              <li>{{ section.settings.tier_2_quantity }}+ items: {{ section.settings.tier_2_discount }}% off</li>
              <li>{{ section.settings.tier_3_quantity }}+ items: {{ section.settings.tier_3_discount }}% off</li>
            </ul>
          </div>
        {% endif %}

        <div class="bundle-pricing">
          <div class="bundle-pricing__row">
            <span>Subtotal (<span data-item-count>0</span> items)</span>
            <span data-subtotal>{{ 0 | money }}</span>
          </div>

          {% if section.settings.enable_discounts %}
            <div class="bundle-pricing__row bundle-pricing__row--discount" data-discount-row hidden>
              <span>Discount (<span data-discount-percent>0</span>%)</span>
              <span data-discount-amount>-{{ 0 | money }}</span>
            </div>
          {% endif %}

          <div class="bundle-pricing__row bundle-pricing__row--total">
            <span>Total</span>
            <span data-total-price>{{ 0 | money }}</span>
          </div>

          <div class="bundle-savings" data-savings-badge>
            You save <span data-savings-amount>{{ 0 | money }}</span>!
          </div>
        </div>

        <button class="bundle-summary__button" type="button" data-add-bundle-to-cart disabled>
          Add Bundle to Cart
        </button>

        <p class="bundle-requirement" data-bundle-requirement>
          Add {{ section.settings.min_items }} items to continue
        </p>
      </aside>
    </div>
  </div>
</div>

<script>
  (() => {
    class BundleBuilder {
      constructor(root) {
        this.root = root;
        this.bundleItems = [];
        this.minItems = {{ section.settings.min_items }};
        this.maxItems = {{ section.settings.max_items }};
        this.enableDiscounts = {{ section.settings.enable_discounts | json }};
        this.moneyFormat = root.dataset.moneyFormat || '{% raw %}${{amount}}{% endraw %}';
        this.discountTiers = [
          { quantity: {{ section.settings.tier_1_quantity }}, discount: {{ section.settings.tier_1_discount }} },
          { quantity: {{ section.settings.tier_2_quantity }}, discount: {{ section.settings.tier_2_discount }} },
          { quantity: {{ section.settings.tier_3_quantity }}, discount: {{ section.settings.tier_3_discount }} }
        ].sort((a, b) => b.quantity - a.quantity);

        this.init();
      }

      init() {
        this.setupProductOptions();
        this.setupEventListeners();
        this.initCarousel();
      }

      initCarousel() {
        this.carouselViewport = this.root.querySelector('[data-carousel-viewport]');
        this.carouselTrack = this.root.querySelector('[data-product-grid]');
        this.prevBtn = this.root.querySelector('[data-carousel-prev]');
        this.nextBtn = this.root.querySelector('[data-carousel-next]');
        this.dotsContainer = this.root.querySelector('[data-carousel-dots]');

        if (!this.carouselViewport || !this.carouselTrack || !this.prevBtn || !this.nextBtn || !this.dotsContainer) return;

        this.carouselItems = Array.from(this.carouselTrack.querySelectorAll('.bundle-product'));
        this.createDots();

        this.prevBtn.addEventListener('click', () => this.scrollCarousel(-1));
        this.nextBtn.addEventListener('click', () => this.scrollCarousel(1));
        this.carouselViewport.addEventListener('scroll', () => this.updateCarouselState(), { passive: true });
        window.addEventListener('resize', () => this.updateCarouselState());

        this.dotsContainer.addEventListener('click', (event) => {
          const dot = event.target.closest('[data-carousel-dot]');
          if (!dot) return;
          this.scrollToIndex(Number(dot.dataset.index));
        });

        this.updateCarouselState();
      }

      createDots() {
        this.dotsContainer.innerHTML = '';

        this.carouselItems.forEach((_, index) => {
          const dot = document.createElement('button');
          dot.type = 'button';
          dot.className = `bundle-carousel__dot${index === 0 ? ' is-active' : ''}`;
          dot.dataset.carouselDot = '';
          dot.dataset.index = index;
          dot.setAttribute('aria-label', `Go to product ${index + 1}`);
          this.dotsContainer.appendChild(dot);
        });
      }

      getCarouselStep() {
        if (!this.carouselItems.length) return 0;

        const item = this.carouselItems[0];
        const gap = parseFloat(window.getComputedStyle(this.carouselTrack).gap) || 0;
        return item.getBoundingClientRect().width + gap;
      }

      scrollCarousel(direction) {
        const step = this.getCarouselStep();
        this.carouselViewport.scrollBy({ left: step * direction, behavior: 'smooth' });
      }

      scrollToIndex(index) {
        const step = this.getCarouselStep();
        this.carouselViewport.scrollTo({ left: step * index, behavior: 'smooth' });
      }

      updateCarouselState() {
        if (!this.carouselViewport || !this.carouselItems.length) return;

        const maxScroll = this.carouselViewport.scrollWidth - this.carouselViewport.clientWidth;
        const scrollLeft = this.carouselViewport.scrollLeft;
        const step = this.getCarouselStep();
        const currentIndex = step ? Math.round(scrollLeft / step) : 0;

        this.prevBtn.disabled = scrollLeft <= 1;
        this.nextBtn.disabled = scrollLeft >= maxScroll - 1;

        this.root.querySelectorAll('[data-carousel-dot]').forEach((dot, index) => {
          dot.classList.toggle('is-active', index === currentIndex);
        });
      }

      setupProductOptions() {
        this.root.querySelectorAll('[data-product-card]').forEach((card) => {
          const variantsScript = card.querySelector('[data-product-variants]');
          card.variants = variantsScript ? JSON.parse(variantsScript.textContent) : [];

          card.querySelectorAll('[data-option-button]').forEach((button) => {
            button.addEventListener('click', () => {
              const group = button.closest('[data-option-group]');
              group.querySelectorAll('[data-option-button]').forEach((item) => item.classList.remove('is-selected'));
              button.classList.add('is-selected');
              this.updateSelectedVariant(card);
            });
          });

          this.updateSelectedVariant(card);
        });
      }

      updateSelectedVariant(card) {
        if (!card.variants || !card.variants.length) return;

        const selectedOptions = [];
        card.querySelectorAll('[data-option-button].is-selected').forEach((button) => {
          selectedOptions[Number(button.dataset.optionIndex)] = button.dataset.optionValue;
        });

        const matchingVariant = card.variants.find((variant) => {
          return (!selectedOptions[0] || variant.option1 === selectedOptions[0])
            && (!selectedOptions[1] || variant.option2 === selectedOptions[1])
            && (!selectedOptions[2] || variant.option3 === selectedOptions[2]);
        });

        const button = card.querySelector('[data-add-to-bundle]');
        const price = card.querySelector('[data-product-price]');

        if (!matchingVariant || !matchingVariant.available) {
          button.disabled = true;
          button.textContent = 'Unavailable';
          return;
        }

        card.dataset.variantId = matchingVariant.id;
        button.dataset.productPrice = matchingVariant.price;
        button.dataset.productImage = matchingVariant.image || button.dataset.productImage;
        button.disabled = false;
        button.textContent = 'Add to Bundle';
        price.textContent = this.formatMoney(matchingVariant.price);
      }

      setupEventListeners() {
        this.root.querySelectorAll('[data-add-to-bundle]').forEach((button) => {
          button.addEventListener('click', () => this.addToBundle(button));
        });

        const addToCartButton = this.root.querySelector('[data-add-bundle-to-cart]');
        if (addToCartButton) {
          addToCartButton.addEventListener('click', () => this.addBundleToCart());
        }
      }

      addToBundle(button) {
        if (this.bundleItems.length >= this.maxItems) {
          alert(`Maximum ${this.maxItems} items allowed in bundle`);
          return;
        }

        const card = button.closest('[data-product-card]');
        const selectedOptions = Array.from(card.querySelectorAll('[data-option-button].is-selected'))
          .sort((a, b) => Number(a.dataset.optionIndex) - Number(b.dataset.optionIndex))
          .map((option) => option.dataset.optionValue);

        const item = {
          id: `${button.dataset.productId}-${card.dataset.variantId}-${Date.now()}`,
          productId: button.dataset.productId,
          variantId: Number(card.dataset.variantId),
          title: button.dataset.productTitle,
          variantText: selectedOptions.length ? selectedOptions.join(' / ') : 'Bundle Item',
          price: Number(button.dataset.productPrice),
          image: button.dataset.productImage
        };

        this.bundleItems.push(item);
        this.updateBundleDisplay();
      }

      removeFromBundle(itemId) {
        this.bundleItems = this.bundleItems.filter((item) => item.id !== itemId);
        this.updateBundleDisplay();
      }

      updateBundleDisplay() {
        const bundleItemsContainer = this.root.querySelector('[data-bundle-items]');
        const emptyBundle = this.root.querySelector('[data-empty-bundle]');

        bundleItemsContainer.querySelectorAll('[data-bundle-summary-item]').forEach((item) => item.remove());

        if (!this.bundleItems.length) {
          emptyBundle.hidden = false;
        } else {
          emptyBundle.hidden = true;

          this.bundleItems.forEach((item) => {
            const itemEl = document.createElement('div');
            itemEl.className = 'bundle-summary-item';
            itemEl.dataset.bundleSummaryItem = '';
            const imageMarkup = item.image
              ? `<img src="${item.image}" alt="${this.escapeHtml(item.title)}" class="bundle-summary-item__image">`
              : '<div class="bundle-summary-item__image" aria-hidden="true"></div>';

            itemEl.innerHTML = `
              ${imageMarkup}
              <div>
                <h3 class="bundle-summary-item__title">${this.escapeHtml(item.title)}</h3>
                <p class="bundle-summary-item__variant">${this.escapeHtml(item.variantText)}</p>
                <p class="bundle-summary-item__price">${this.formatMoney(item.price)}</p>
              </div>
              <button class="bundle-summary-item__remove" type="button" data-remove-item="${item.id}" aria-label="Remove ${this.escapeHtml(item.title)}">
                <i class="ph ph-x" aria-hidden="true"></i>
              </button>
            `;

            itemEl.querySelector('[data-remove-item]').addEventListener('click', (event) => {
              this.removeFromBundle(event.currentTarget.dataset.removeItem);
            });

            bundleItemsContainer.appendChild(itemEl);
          });
        }

        this.updatePricing();
        this.updateAddToCartButton();
      }

      updatePricing() {
        const itemCount = this.bundleItems.length;
        const subtotal = this.bundleItems.reduce((sum, item) => sum + item.price, 0);
        let discount = 0;
        let discountPercent = 0;

        if (this.enableDiscounts) {
          for (const tier of this.discountTiers) {
            if (itemCount >= tier.quantity) {
              discountPercent = tier.discount;
              discount = Math.round(subtotal * (tier.discount / 100));
              break;
            }
          }
        }

        const total = subtotal - discount;

        this.root.querySelector('[data-item-count]').textContent = itemCount;
        this.root.querySelector('[data-subtotal]').textContent = this.formatMoney(subtotal);
        this.root.querySelector('[data-total-price]').textContent = this.formatMoney(total);

        if (this.enableDiscounts) {
          const discountRow = this.root.querySelector('[data-discount-row]');
          const savingsBadge = this.root.querySelector('[data-savings-badge]');

          if (discount > 0) {
            discountRow.hidden = false;
            savingsBadge.style.display = 'block';
            this.root.querySelector('[data-discount-percent]').textContent = discountPercent;
            this.root.querySelector('[data-discount-amount]').textContent = `-${this.formatMoney(discount)}`;
            this.root.querySelector('[data-savings-amount]').textContent = this.formatMoney(discount);
          } else {
            discountRow.hidden = true;
            savingsBadge.style.display = 'none';
          }
        }
      }

      updateAddToCartButton() {
        const button = this.root.querySelector('[data-add-bundle-to-cart]');
        const requirement = this.root.querySelector('[data-bundle-requirement]');
        const itemCount = this.bundleItems.length;

        if (itemCount >= this.minItems && itemCount <= this.maxItems) {
          button.disabled = false;
          requirement.textContent = `Ready to add ${itemCount} items to cart`;
        } else if (itemCount < this.minItems) {
          const remaining = this.minItems - itemCount;
          button.disabled = true;
          requirement.textContent = `Add ${remaining} more item${remaining > 1 ? 's' : ''} to continue`;
        } else {
          button.disabled = true;
          requirement.textContent = `Maximum ${this.maxItems} items allowed`;
        }
      }

      async addBundleToCart() {
        if (this.bundleItems.length < this.minItems) return;

        const button = this.root.querySelector('[data-add-bundle-to-cart]');
        button.disabled = true;
        button.textContent = 'Adding to Cart...';

        try {
          const items = this.bundleItems.map((item) => ({
            id: item.variantId,
            quantity: 1
          }));

          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({ items })
          });

          if (!response.ok) throw new Error('Failed to add bundle to cart');

          button.textContent = 'Added to Cart!';

          setTimeout(() => {
            window.location.href = '/cart';
          }, 500);
        } catch (error) {
          console.error('Error adding bundle to cart:', error);
          alert('There was an error adding items to cart. Please try again.');
          button.disabled = false;
          button.textContent = 'Add Bundle to Cart';
        }
      }

      formatMoney(cents) {
        if (window.Shopify && typeof window.Shopify.formatMoney === 'function') {
          return window.Shopify.formatMoney(cents, this.moneyFormat);
        }

        return `$${(Number(cents) / 100).toFixed(2)}`;
      }

      escapeHtml(value) {
        return String(value || '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');
      }
    }

    const initBundleBuilder = (container = document) => {
      container.querySelectorAll('[data-bundle-builder="{{ section.id }}"]').forEach((root) => {
        if (root.dataset.bundleInitialized) return;
        root.dataset.bundleInitialized = 'true';
        new BundleBuilder(root);
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => initBundleBuilder());
    } else {
      initBundleBuilder();
    }

    document.addEventListener('shopify:section:load', (event) => {
      initBundleBuilder(event.target);
    });
  })();
</script>

